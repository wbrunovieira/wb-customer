# App
NODE_ENV=development
PORT=3000

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/wb_customer

# JWT (min 32 chars)
JWT_SECRET=your-super-secret-key-min-32-chars-here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Seed — admin created on startup if it does not exist
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=CHANGE_ME

# Adapters (local | google-drive)
STORAGE_ADAPTER=local

# Calendar adapter (mock | google-calendar)
CALENDAR_ADAPTER=mock

# Google Drive (required when STORAGE_ADAPTER=google-drive)
# GOOGLE_SERVICE_ACCOUNT_JSON='{...}'
# GOOGLE_DRIVE_ROOT_FOLDER_ID=your-root-folder-id

# Google Calendar (required when CALENDAR_ADAPTER=google-calendar)
# GOOGLE_CALENDAR_SERVICE_ACCOUNT_JSON='{...}'
# GOOGLE_CALENDAR_ID=calendar-id@group.calendar.google.com
