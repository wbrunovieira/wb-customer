# App
NODE_ENV=development
PORT=3000

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/wb_customer

# JWT (min 32 chars)
JWT_SECRET=your-super-secret-key-min-32-chars-here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Seed — admin created on startup if it does not exist
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=CHANGE_ME

# Adapters (local | google-drive)
STORAGE_ADAPTER=local

# Calendar adapter (mock | google-calendar)
CALENDAR_ADAPTER=mock

# Google Drive (required when STORAGE_ADAPTER=google-drive)
# GOOGLE_SERVICE_ACCOUNT_JSON='{...}'
# GOOGLE_DRIVE_ROOT_FOLDER_ID=your-root-folder-id

# Google Calendar (required when CALENDAR_ADAPTER=google-calendar)
# GOOGLE_CALENDAR_SERVICE_ACCOUNT_JSON='{...}'
# GOOGLE_CALENDAR_ID=calendar-id@group.calendar.google.com

# Transcriptor — audio transcription service for phone_call activities
# TRANSCRIPTOR_BASE_URL=https://your-transcription-service.example.com
# TRANSCRIPTOR_API_KEY=your-transcriptor-api-key

# Activities — future integrations (uncomment when ready)
# GoTo VoIP — outbound call dialing + webhook for call recordings
# GOTO_API_KEY=your-goto-api-key
# GOTO_ACCOUNT_KEY=your-goto-account-key
# GOTO_WEBHOOK_SECRET=your-goto-webhook-secret

# Evolution API — WhatsApp automation
# EVOLUTION_API_URL=https://your-evolution-instance.example.com
# EVOLUTION_API_KEY=your-evolution-api-key
# EVOLUTION_INSTANCE_NAME=your-instance-name

# Internal cron/webhook security
# Used by POST /api/v1/google/check-recordings and /api/v1/google/check-transcriptions
# Generate with: openssl rand -base64 32
# CRON_SECRET=generate-with-openssl-rand-base64-32
