# App
NODE_ENV=development
PORT=3000

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/wb_customer

# JWT (min 32 chars)
JWT_SECRET=your-super-secret-key-min-32-chars-here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Seed — admin created on startup if it does not exist
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=CHANGE_ME

# Adapters (local | google-drive)
STORAGE_ADAPTER=local

# Calendar adapter (mock | google-calendar)
CALENDAR_ADAPTER=mock

# Google OAuth (required when CALENDAR_ADAPTER=google-calendar or Gmail enabled)
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-client-secret
# GOOGLE_REDIRECT_URI=https://your-domain/api/v1/google/callback

# Transcriptor — audio transcription service (phone_call + WhatsApp audio)
# TRANSCRIPTOR_BASE_URL=https://your-transcription-service.example.com
# TRANSCRIPTOR_API_KEY=your-transcriptor-api-key

# ─── GoTo Connect (VoIP) ─────────────────────────────────────────────────────
# OAuth2 — tokens stored/auto-refreshed in DB (GoToToken model)
# Initial tokens must be seeded manually from production server
# GOTO_CLIENT_ID=your-goto-client-id
# GOTO_CLIENT_SECRET=your-goto-client-secret
# GOTO_ACCOUNT_KEY=your-goto-account-key
# GOTO_WEBHOOK_SECRET=your-goto-webhook-secret
# GOTO_DEFAULT_OWNER_ID=your-default-owner-id
# GOTO_ACCESS_TOKEN=seed-once-then-auto-refreshed
# GOTO_REFRESH_TOKEN=seed-once-then-auto-refreshed
# GOTO_TOKEN_EXPIRES_AT=2026-01-01T00:00:00.000Z

# ─── WhatsApp via Evolution API ──────────────────────────────────────────────
# EVOLUTION_API_URL=https://your-evolution-instance.example.com
# EVOLUTION_API_KEY=your-evolution-api-key
# EVOLUTION_INSTANCE=your-instance-name
# EVOLUTION_WEBHOOK_SECRET=your-evolution-webhook-secret
# EVOLUTION_OWNER_ID=your-owner-id

# ─── Meta Marketing API ──────────────────────────────────────────────────────
# META_APP_ID=<your-meta-app-id>
# META_APP_SECRET=<your-meta-app-secret>
# META_SYSTEM_USER_TOKEN=<system-user-permanent-token>
# META_API_VERSION=v21.0
# META_ENCRYPTION_KEY=<32-char-random-string>
# META_MOCK_MODE=true

# ─── Internal security ───────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
# CRON_SECRET=generate-with-openssl-rand-base64-32
# INTERNAL_API_KEY=generate-with-openssl-rand-base64-32
