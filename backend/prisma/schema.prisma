generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  admin
  manager
  employee
  customer
}

model UserIdentity {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String    @map("password_hash")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  @@map("user_identities")
}

model UserProfile {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  name      String
  phone     String?
  avatarUrl String?  @map("avatar_url")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("user_profiles")
}

model UserAuthorization {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  role      UserRole
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("user_authorizations")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  token     String    @unique
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@map("refresh_tokens")
}

// ─────────────────────────────────────────
// CUSTOMERS
// ─────────────────────────────────────────

enum CustomerStatus {
  active
  inactive
}

enum CustomerActivityType {
  created
  updated
  assigned
  contact_added
  document_uploaded
  meeting_scheduled
  meeting_completed
  note_added
  email_received
}

model CustomerCategory {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  customers Customer[]

  @@map("customer_categories")
}

model Customer {
  id              String         @id @default(uuid())
  name            String
  email           String         @unique
  phone           String?
  document        String?        @unique
  website         String?
  notes           String?
  status          CustomerStatus @default(active)
  categoryId      String?        @map("category_id")
  driveFolderId   String?        @map("drive_folder_id")
  createdByUserId String         @map("created_by_user_id")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")
  deletedAt       DateTime?      @map("deleted_at")

  category     CustomerCategory?  @relation(fields: [categoryId], references: [id])
  contacts     Contact[]
  employees    CustomerEmployee[]
  activities   CustomerActivity[]
  documents    Document[]
  meetings     Meeting[]
  portalUsers  CustomerUser[]
  sprints          Sprint[]
  tasks            Task[]
  activityLogs     Activity[]
  creatives        Creative[]
  creativeStrategies CreativeStrategy[]
  campaigns        Campaign[]
  metaAdAccount    MetaAdAccount?

  @@index([categoryId])
  @@map("customers")
}

// ─────────────────────────────────────────
// CUSTOMER PORTAL
// ─────────────────────────────────────────

enum CustomerUserRole {
  master
  member
}

model CustomerUser {
  id           String           @id @default(uuid())
  userId       String           @unique @map("user_id")
  customerId   String           @map("customer_id")
  customerRole CustomerUserRole @default(member) @map("customer_role")
  createdBy    String           @map("created_by")
  createdAt    DateTime         @default(now()) @map("created_at")
  deletedAt    DateTime?        @map("deleted_at")

  customer Customer @relation(fields: [customerId], references: [id])

  @@index([customerId])
  @@map("customer_users")
}

model Contact {
  id         String   @id @default(uuid())
  customerId String   @map("customer_id")
  name       String
  email      String?
  phone      String?
  role       String?
  isPrimary  Boolean  @default(false) @map("is_primary")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  customer     Customer   @relation(fields: [customerId], references: [id])
  meetings     Meeting[]
  activityLogs Activity[]

  @@index([customerId])
  @@map("contacts")
}

model CustomerEmployee {
  customerId String   @map("customer_id")
  userId     String   @map("user_id")
  assignedAt DateTime @default(now()) @map("assigned_at")
  assignedBy String   @map("assigned_by")

  customer Customer @relation(fields: [customerId], references: [id])

  @@id([customerId, userId])
  @@index([userId])
  @@map("customer_employees")
}

model CustomerActivity {
  id          String               @id @default(uuid())
  customerId  String               @map("customer_id")
  userId      String               @map("user_id")
  type        CustomerActivityType
  description String
  metadata    Json?
  createdAt   DateTime             @default(now()) @map("created_at")

  customer Customer @relation(fields: [customerId], references: [id])

  @@index([customerId])
  @@map("customer_activities")
}

// ─────────────────────────────────────────
// DOCUMENTS
// ─────────────────────────────────────────

enum DocumentType {
  proposal
  contract
  addendum
  other
}

enum DocumentStatus {
  pending_signature
  signed
  expired
  cancelled
}

model Document {
  id               String         @id @default(uuid())
  customerId       String         @map("customer_id")
  type             DocumentType
  title            String
  driveFileId      String         @map("drive_file_id")
  driveViewUrl     String         @map("drive_view_url")
  driveDownloadUrl String         @map("drive_download_url")
  mimeType         String         @map("mime_type")
  sizeBytes        Int?           @map("size_bytes")
  signedAt         DateTime?      @map("signed_at")
  notes            String?
  status           DocumentStatus @default(pending_signature)
  uploadedByUserId String         @map("uploaded_by_user_id")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")
  deletedAt        DateTime?      @map("deleted_at")

  customer Customer @relation(fields: [customerId], references: [id])

  @@index([customerId])
  @@map("documents")
}

// ─────────────────────────────────────────
// MEETINGS
// ─────────────────────────────────────────

enum MeetingStatus {
  scheduled
  ended
  cancelled
}

model MeetingType {
  id              String    @id @default(uuid())
  name            String    @unique
  description     String?
  durationMinutes Int       @default(60) @map("duration_minutes")
  color           String    @default("#3B82F6")
  isActive        Boolean   @default(true) @map("is_active")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  meetings Meeting[]

  @@map("meeting_types")
}

model Meeting {
  id                  String        @id @default(uuid())
  customerId          String        @map("customer_id")
  contactId           String?       @map("contact_id")
  meetingTypeId       String?       @map("meeting_type_id")
  title               String
  description         String?
  startAt             DateTime      @map("start_at")
  endAt               DateTime?     @map("end_at")
  actualStartAt       DateTime?     @map("actual_start_at")
  actualEndAt         DateTime?     @map("actual_end_at")
  googleEventId       String?       @unique @map("google_event_id")
  meetLink            String?       @map("meet_link")
  attendees           Json          @default("[]")    // [{email, responseStatus, organizer?, self?}]
  status              MeetingStatus @default(scheduled)
  scheduledByUserId   String        @map("scheduled_by_user_id")

  // Recording
  recordingDriveId    String?       @map("recording_drive_id")
  recordingUrl        String?       @map("recording_url")
  recordingMovedAt    DateTime?     @map("recording_moved_at")

  // Transcription
  transcriptionJobId  String?       @map("transcription_job_id")
  transcriptText      String?       @map("transcript_text")
  transcribedAt       DateTime?     @map("transcribed_at")
  nativeTranscriptUrl String?       @map("native_transcript_url")
  meetingSummary      String?       @map("meeting_summary")

  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")

  customer    Customer     @relation(fields: [customerId], references: [id])
  contact     Contact?     @relation(fields: [contactId], references: [id])
  meetingType MeetingType? @relation(fields: [meetingTypeId], references: [id])

  @@index([customerId])
  @@index([status])
  @@index([startAt])
  @@map("meetings")
}

// ─────────────────────────────────────────
// GOOGLE OAUTH
// ─────────────────────────────────────────

model GoogleToken {
  id             String   @id
  accessToken    String   @map("access_token")
  refreshToken   String   @map("refresh_token")
  expiresAt      DateTime @map("expires_at")
  scope          String
  email          String
  gmailHistoryId String?  @map("gmail_history_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("google_tokens")
}

// ─────────────────────────────────────────
// TASKS
// ─────────────────────────────────────────

enum TaskStatus {
  idea_could
  idea_should
  backlog
  todo
  in_progress
  review
  done
  cancelled
}

enum RecurrenceType {
  none
  daily
  weekly
  monthly
  custom
}

model Sprint {
  id         String   @id @default(uuid())
  customerId String   @map("customer_id")
  name       String
  startAt    DateTime @map("start_at")
  endAt      DateTime @map("end_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  customer Customer @relation(fields: [customerId], references: [id])
  tasks    Task[]

  @@index([customerId])
  @@map("sprints")
}

model Task {
  id              String         @id @default(uuid())
  customerId      String         @map("customer_id")
  sprintId        String?        @map("sprint_id")
  parentTaskId    String?        @map("parent_task_id")
  title           String
  description     String?
  status          TaskStatus     @default(backlog)
  ownerUserId     String         @map("owner_user_id")
  assigneeUserId  String?        @map("assignee_user_id")
  startAt         DateTime?      @map("start_at")
  endAt           DateTime?      @map("end_at")
  estimatedHours  Float?         @map("estimated_hours")
  trackedSeconds  Int            @default(0) @map("tracked_seconds")
  impact          Int?
  confidence      Int?
  effort          Int?
  recurrenceType  RecurrenceType @default(none) @map("recurrence_type")
  recurrenceRule  Json?          @map("recurrence_rule")
  progress        Int            @default(0)
  boardPosition   Int            @default(0) @map("board_position")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")
  deletedAt       DateTime?      @map("deleted_at")

  customer  Customer        @relation(fields: [customerId], references: [id])
  sprint    Sprint?         @relation(fields: [sprintId], references: [id])
  parent    Task?           @relation("TaskSubtasks", fields: [parentTaskId], references: [id])
  subtasks  Task[]          @relation("TaskSubtasks")
  checklist ChecklistItem[]
  tags      TaskTagLink[]
  activityLog TaskActivityLog[]
  comments  TaskComment[]
  timeEntries TimeEntry[]

  @@index([customerId])
  @@index([sprintId])
  @@index([assigneeUserId])
  @@map("tasks")
}

model ChecklistItem {
  id        String   @id @default(uuid())
  taskId    String   @map("task_id")
  text      String
  isDone    Boolean  @default(false) @map("is_done")
  position  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  task Task @relation(fields: [taskId], references: [id])

  @@index([taskId])
  @@map("checklist_items")
}

model TaskTag {
  id         String   @id @default(uuid())
  customerId String?  @map("customer_id")
  name       String
  color      String   @default("#3B82F6")
  createdAt  DateTime @default(now()) @map("created_at")

  links TaskTagLink[]

  @@map("task_tags")
}

model TaskTagLink {
  taskId String @map("task_id")
  tagId  String @map("tag_id")

  task Task    @relation(fields: [taskId], references: [id])
  tag  TaskTag @relation(fields: [tagId], references: [id])

  @@id([taskId, tagId])
  @@map("task_tag_links")
}

model TaskActivityLog {
  id        String   @id @default(uuid())
  taskId    String   @map("task_id")
  userId    String   @map("user_id")
  action    String
  fromValue String?  @map("from_value")
  toValue   String?  @map("to_value")
  createdAt DateTime @default(now()) @map("created_at")

  task Task @relation(fields: [taskId], references: [id])

  @@index([taskId])
  @@map("task_activity_logs")
}

model TaskTemplate {
  id          String   @id @default(uuid())
  name        String
  description String?
  tasks       Json
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("task_templates")
}

model TimeEntry {
  id           String    @id @default(uuid())
  taskId       String    @map("task_id")
  userId       String    @map("user_id")
  startedAt    DateTime  @default(now()) @map("started_at")
  stoppedAt    DateTime? @map("stopped_at")
  durationSecs Int?      @map("duration_secs")
  createdAt    DateTime  @default(now()) @map("created_at")

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@map("time_entries")
}

model TaskComment {
  id           String    @id @default(uuid())
  taskId       String    @map("task_id")
  parentId     String?   @map("parent_id")
  authorUserId String    @map("author_user_id")
  body         String?
  audioUrl     String?   @map("audio_url")
  resolved     Boolean   @default(false)
  deletedAt    DateTime? @map("deleted_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  task        Task              @relation(fields: [taskId], references: [id], onDelete: Cascade)
  parent      TaskComment?      @relation("CommentReplies", fields: [parentId], references: [id])
  replies     TaskComment[]     @relation("CommentReplies")
  attachments CommentAttachment[]
  annotations ImageAnnotation[]
  reactions   CommentReaction[]

  @@index([taskId])
  @@map("task_comments")
}

model CommentAttachment {
  id        String   @id @default(uuid())
  commentId String   @map("comment_id")
  url       String
  name      String
  mimeType  String   @map("mime_type")
  sizeBytes BigInt?  @map("size_bytes")
  createdAt DateTime @default(now()) @map("created_at")

  comment TaskComment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@map("comment_attachments")
}

model ImageAnnotation {
  id        String   @id @default(uuid())
  commentId String   @map("comment_id")
  imageUrl  String   @map("image_url")
  x         Float
  y         Float
  number    Int
  text      String
  createdAt DateTime @default(now()) @map("created_at")

  comment TaskComment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@map("image_annotations")
}

model CommentReaction {
  commentId String   @map("comment_id")
  userId    String   @map("user_id")
  emoji     String
  createdAt DateTime @default(now()) @map("created_at")

  comment TaskComment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@id([commentId, userId, emoji])
  @@map("comment_reactions")
}

// ─────────────────────────────────────────
// CREATIVES
// ─────────────────────────────────────────

enum CreativeType {
  image
  video
  carousel
}

enum CreativeStatus {
  draft
  active
  paused
  archived
}

enum CampaignObjective {
  awareness
  traffic
  engagement
  leads
  sales
  retargeting
}

enum CreativeStage {
  exploration
  refinement
  scale
}

enum StrategyPhase {
  exploration
  refinement
}

enum StrategyStatus {
  active
  completed
  paused
}

model Creative {
  id                String            @id @default(uuid())
  customerId        String            @map("customer_id")
  title             String
  caption           String?
  textInCreative    String?           @map("text_in_creative")
  designDescription String?           @map("design_description")
  type              CreativeType
  stage             CreativeStage?
  parentCreativeId  String?           @map("parent_creative_id")
  variationAspects  String[]          @default([]) @map("variation_aspects")
  objective         CampaignObjective?
  status            CreativeStatus    @default(draft)

  driveFileId       String?           @map("drive_file_id")
  driveViewUrl      String?           @map("drive_view_url")
  driveDownloadUrl  String?           @map("drive_download_url")
  thumbnailUrl      String?           @map("thumbnail_url")
  mimeType          String?           @map("mime_type")
  sizeBytes         BigInt?           @map("size_bytes")

  createdByUserId   String            @map("created_by_user_id")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")
  deletedAt         DateTime?         @map("deleted_at")

  customer          Customer          @relation(fields: [customerId], references: [id])
  parentCreative    Creative?         @relation("CreativeVariations", fields: [parentCreativeId], references: [id])
  variations        Creative[]        @relation("CreativeVariations")
  strategyItems     CreativeStrategyItem[]
  performances      CreativePerformance[]
  ads               Ad[]

  @@index([customerId])
  @@map("creatives")
}

model CreativePerformance {
  id          String    @id @default(uuid())
  creativeId  String    @map("creative_id")
  platform    String
  campaignId  String?   @map("campaign_id")
  impressions Int       @default(0)
  clicks      Int       @default(0)
  conversions Int       @default(0)
  spend       Float     @default(0)
  ctr         Float?
  cpc         Float?
  cpa         Float?
  roas        Float?
  startDate   DateTime  @map("start_date")
  endDate     DateTime? @map("end_date")
  notes       String?
  recordedAt  DateTime  @default(now()) @map("recorded_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  creative Creative @relation(fields: [creativeId], references: [id], onDelete: Cascade)

  @@index([creativeId])
  @@map("creative_performances")
}

model CreativeStrategy {
  id               String            @id @default(uuid())
  customerId       String            @map("customer_id")
  name             String
  phase            StrategyPhase
  status           StrategyStatus    @default(active)
  objective        CampaignObjective?
  budget           Float?
  durationDays     Int?              @map("duration_days")
  startAt          DateTime?         @map("start_at")
  endAt            DateTime?         @map("end_at")
  winnerId         String?           @map("winner_id")
  parentStrategyId String?           @map("parent_strategy_id")
  notes            String?
  createdByUserId  String            @map("created_by_user_id")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  customer       Customer               @relation(fields: [customerId], references: [id])
  items          CreativeStrategyItem[]
  parentStrategy CreativeStrategy?      @relation("StrategyRefinements", fields: [parentStrategyId], references: [id])
  refinements    CreativeStrategy[]     @relation("StrategyRefinements")

  @@index([customerId])
  @@map("creative_strategies")
}

model CreativeStrategyItem {
  strategyId String   @map("strategy_id")
  creativeId String   @map("creative_id")
  position   Int      @default(0)
  addedAt    DateTime @default(now()) @map("added_at")

  strategy CreativeStrategy @relation(fields: [strategyId], references: [id], onDelete: Cascade)
  creative Creative         @relation(fields: [creativeId], references: [id], onDelete: Cascade)

  @@id([strategyId, creativeId])
  @@map("creative_strategy_items")
}

// ─────────────────────────────────────────
// ACTIVITIES (Communication Log)
// ─────────────────────────────────────────

model Activity {
  id                String    @id @default(uuid())
  customerId        String    @map("customer_id")
  contactId         String?   @map("contact_id")
  type              String
  status            String    @default("open")
  subject           String?
  description       String?
  scheduledAt       DateTime? @map("scheduled_at")
  occurredAt        DateTime? @map("occurred_at")
  durationSecs      Int?      @map("duration_secs")
  audioUrl          String?   @map("audio_url")
  transcriptText    String?   @map("transcript_text")
  externalId        String?   @map("external_id")
  direction         String?
  createdByUserId   String    @map("created_by_user_id")
  assignedToUserId  String?   @map("assigned_to_user_id")
  deletedAt         DateTime? @map("deleted_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  // GoTo Connect fields
  gotoCallId             String?  @unique @map("goto_call_id")
  gotoCallOutcome        String?  @map("goto_call_outcome")
  gotoDuration           Int?     @map("goto_duration")
  gotoRecordingDriveId   String?  @map("goto_recording_drive_id")
  gotoRecordingUrl       String?  @map("goto_recording_url")
  gotoRecordingUrl2      String?  @map("goto_recording_url2")
  gotoTranscriptionJobId String?  @map("goto_transcription_job_id")
  gotoTranscriptText     String?  @map("goto_transcript_text")
  callContactType        String?  @map("call_contact_type")

  // Email (Gmail) fields
  emailMessageId   String?  @unique @map("email_message_id")
  emailThreadId    String?  @map("email_thread_id")
  emailSubject     String?  @map("email_subject")
  emailFromAddress String?  @map("email_from_address")
  emailFromName    String?  @map("email_from_name")
  emailReplied     Boolean  @default(false) @map("email_replied")

  customer         Customer              @relation(fields: [customerId], references: [id])
  contact          Contact?              @relation(fields: [contactId], references: [id])
  attachments      ActivityAttachment[]
  whatsappMessages WhatsAppMessage[]

  @@index([customerId])
  @@index([externalId])
  @@map("activities")
}

model ActivityAttachment {
  id         String   @id @default(uuid())
  activityId String   @map("activity_id")
  url        String
  mimeType   String   @map("mime_type")
  fileName   String   @map("file_name")
  sizeBytes  BigInt?  @map("size_bytes")
  createdAt  DateTime @default(now()) @map("created_at")

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@map("activity_attachments")
}

// ─── GoTo Connect ──────────────────────────────────────────────────────────

model GoToToken {
  id           String   @id @default("singleton")
  accessToken  String   @map("access_token")
  refreshToken String   @map("refresh_token")
  expiresAt    DateTime @map("expires_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("goto_tokens")
}

// ─── WhatsApp (Evolution API) ──────────────────────────────────────────────

model WhatsAppMessage {
  id                      String    @id @default(uuid())
  activityId              String    @map("activity_id")
  messageId               String    @unique @map("message_id")
  remoteJid               String    @map("remote_jid")
  fromMe                  Boolean   @map("from_me")
  senderName              String?   @map("sender_name")
  text                    String?
  messageType             String    @map("message_type")
  mediaLabel              String?   @map("media_label")
  mediaDriveId            String?   @map("media_drive_id")
  mediaUrl                String?   @map("media_url")
  mediaTranscriptionJobId String?   @map("media_transcription_job_id")
  mediaTranscriptText     String?   @map("media_transcript_text")
  timestamp               DateTime

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@index([activityId])
  @@index([remoteJid])
  @@map("whatsapp_messages")
}

// ─────────────────────────────────────────
// PAID TRAFFIC
// ─────────────────────────────────────────

model MetaConfig {
  id                String   @id @default("meta-config-singleton")
  appId             String   @map("app_id")
  appSecret         String   @map("app_secret")
  systemUserToken   String   @map("system_user_token")
  bmId              String   @map("bm_id")
  ownAdAccountId    String?  @map("own_ad_account_id")
  ownAdAccountName  String?  @map("own_ad_account_name")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("meta_config")
}

model MetaAdAccount {
  id                 String   @id @default(uuid())
  customerId         String   @unique @map("customer_id")
  adAccountId        String   @map("ad_account_id")
  pageId             String?  @map("page_id")
  pixelId            String?  @map("pixel_id")
  instagramActorId   String?  @map("instagram_actor_id")
  accountName        String?  @map("account_name")
  isActive           Boolean  @default(true) @map("is_active")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  customer Customer @relation(fields: [customerId], references: [id])

  @@map("meta_ad_accounts")
}

enum AdCampaignObjective {
  CONVERSIONS
  LINK_CLICKS
  REACH
  BRAND_AWARENESS
  LEAD_GENERATION
  VIDEO_VIEWS
  POST_ENGAGEMENT
}

enum AdPublishStatus {
  draft
  ready_to_publish
  publishing
  published
  publish_failed
}

enum AdCampaignStatus {
  active
  paused
  archived
}

model Campaign {
  id              String              @id @default(uuid())
  customerId      String              @map("customer_id")
  name            String
  objective       AdCampaignObjective
  status          AdCampaignStatus    @default(active)
  publishStatus   AdPublishStatus     @default(draft) @map("publish_status")
  plannedBudget   Float?              @map("planned_budget")
  dailyBudget     Float?              @map("daily_budget")
  startAt         DateTime?           @map("start_at")
  endAt           DateTime?           @map("end_at")
  notes           String?
  metaCampaignId  String?             @map("meta_campaign_id")
  publishError    String?             @map("publish_error")
  createdByUserId String              @map("created_by_user_id")
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  customer Customer @relation(fields: [customerId], references: [id])
  adSets   AdSet[]

  @@index([customerId])
  @@map("campaigns")
}

model AdSet {
  id               String           @id @default(uuid())
  campaignId       String           @map("campaign_id")
  name             String
  status           AdCampaignStatus @default(active)
  publishStatus    AdPublishStatus  @default(draft) @map("publish_status")
  dailyBudget      Float?           @map("daily_budget")
  totalBudget      Float?           @map("total_budget")
  startAt          DateTime?        @map("start_at")
  endAt            DateTime?        @map("end_at")
  targeting        Json?
  optimizationGoal String?          @map("optimization_goal")
  billingEvent     String?          @map("billing_event")
  metaAdSetId      String?          @map("meta_ad_set_id")
  publishError     String?          @map("publish_error")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  ads      Ad[]

  @@index([campaignId])
  @@map("ad_sets")
}

enum AdCallToAction {
  LEARN_MORE
  SHOP_NOW
  SIGN_UP
  CONTACT_US
  BOOK_NOW
  DOWNLOAD
  GET_QUOTE
  SUBSCRIBE
  WATCH_MORE
  NO_BUTTON
}

model Ad {
  id              String           @id @default(uuid())
  adSetId         String           @map("ad_set_id")
  creativeId      String?          @map("creative_id")
  name            String
  status          AdCampaignStatus @default(active)
  publishStatus   AdPublishStatus  @default(draft) @map("publish_status")
  primaryText     String?          @map("primary_text")
  headline        String?
  description     String?
  callToAction    AdCallToAction   @default(LEARN_MORE) @map("call_to_action")
  destinationUrl  String?          @map("destination_url")
  metaAdId        String?          @map("meta_ad_id")
  metaCreativeId  String?          @map("meta_creative_id")
  publishError    String?          @map("publish_error")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  adSet        AdSet           @relation(fields: [adSetId], references: [id], onDelete: Cascade)
  creative     Creative?       @relation(fields: [creativeId], references: [id])
  dailyMetrics AdDailyMetric[]

  @@index([adSetId])
  @@index([creativeId])
  @@map("ads")
}

model AdDailyMetric {
  id          String   @id @default(uuid())
  adId        String   @map("ad_id")
  campaignId  String   @map("campaign_id")
  date        DateTime @db.Date
  impressions Int      @default(0)
  clicks      Int      @default(0)
  reach       Int      @default(0)
  spent       Float    @default(0)
  conversions Int      @default(0)
  results     Int      @default(0)
  ctr         Float?
  cpc         Float?
  cpm         Float?
  cpp         Float?
  roas        Float?
  frequency   Float?

  ad Ad @relation(fields: [adId], references: [id], onDelete: Cascade)

  @@unique([adId, date])
  @@index([adId])
  @@index([campaignId])
  @@index([date])
  @@map("ad_daily_metrics")
}
