generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  admin
  manager
  employee
  customer
}

model UserIdentity {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String    @map("password_hash")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  @@map("user_identities")
}

model UserProfile {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  name      String
  phone     String?
  avatarUrl String?  @map("avatar_url")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("user_profiles")
}

model UserAuthorization {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  role      UserRole
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("user_authorizations")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  token     String    @unique
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@map("refresh_tokens")
}

// ─────────────────────────────────────────
// CUSTOMERS
// ─────────────────────────────────────────

enum CustomerStatus {
  lead
  active
  inactive
}

enum CustomerActivityType {
  created
  updated
  assigned
  contact_added
  document_uploaded
  meeting_scheduled
  meeting_completed
  note_added
}

model CustomerCategory {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  customers Customer[]

  @@map("customer_categories")
}

model Customer {
  id              String         @id @default(uuid())
  name            String
  email           String         @unique
  phone           String?
  document        String?        @unique
  website         String?
  notes           String?
  status          CustomerStatus @default(lead)
  categoryId      String?        @map("category_id")
  driveFolderId   String?        @map("drive_folder_id")
  createdByUserId String         @map("created_by_user_id")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")
  deletedAt       DateTime?      @map("deleted_at")

  category    CustomerCategory?  @relation(fields: [categoryId], references: [id])
  contacts    Contact[]
  employees   CustomerEmployee[]
  activities  CustomerActivity[]
  documents   Document[]
  meetings    Meeting[]

  @@index([categoryId])
  @@map("customers")
}

model Contact {
  id         String   @id @default(uuid())
  customerId String   @map("customer_id")
  name       String
  email      String?
  phone      String?
  role       String?
  isPrimary  Boolean  @default(false) @map("is_primary")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  customer Customer  @relation(fields: [customerId], references: [id])
  meetings Meeting[]

  @@index([customerId])
  @@map("contacts")
}

model CustomerEmployee {
  customerId String   @map("customer_id")
  userId     String   @map("user_id")
  assignedAt DateTime @default(now()) @map("assigned_at")
  assignedBy String   @map("assigned_by")

  customer Customer @relation(fields: [customerId], references: [id])

  @@id([customerId, userId])
  @@index([userId])
  @@map("customer_employees")
}

model CustomerActivity {
  id          String               @id @default(uuid())
  customerId  String               @map("customer_id")
  userId      String               @map("user_id")
  type        CustomerActivityType
  description String
  metadata    Json?
  createdAt   DateTime             @default(now()) @map("created_at")

  customer Customer @relation(fields: [customerId], references: [id])

  @@index([customerId])
  @@map("customer_activities")
}

// ─────────────────────────────────────────
// DOCUMENTS
// ─────────────────────────────────────────

enum DocumentType {
  proposal
  contract
  addendum
  other
}

enum DocumentStatus {
  pending_signature
  signed
  expired
  cancelled
}

model Document {
  id               String         @id @default(uuid())
  customerId       String         @map("customer_id")
  type             DocumentType
  title            String
  driveFileId      String         @map("drive_file_id")
  driveViewUrl     String         @map("drive_view_url")
  driveDownloadUrl String         @map("drive_download_url")
  mimeType         String         @map("mime_type")
  sizeBytes        Int?           @map("size_bytes")
  signedAt         DateTime?      @map("signed_at")
  notes            String?
  status           DocumentStatus @default(pending_signature)
  uploadedByUserId String         @map("uploaded_by_user_id")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")
  deletedAt        DateTime?      @map("deleted_at")

  customer Customer @relation(fields: [customerId], references: [id])

  @@index([customerId])
  @@map("documents")
}

// ─────────────────────────────────────────
// MEETINGS
// ─────────────────────────────────────────

enum MeetingStatus {
  scheduled
  ended
  cancelled
}

model MeetingType {
  id              String    @id @default(uuid())
  name            String    @unique
  description     String?
  durationMinutes Int       @default(60) @map("duration_minutes")
  color           String    @default("#3B82F6")
  isActive        Boolean   @default(true) @map("is_active")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  meetings Meeting[]

  @@map("meeting_types")
}

model Meeting {
  id                  String        @id @default(uuid())
  customerId          String        @map("customer_id")
  contactId           String?       @map("contact_id")
  meetingTypeId       String?       @map("meeting_type_id")
  title               String
  description         String?
  startAt             DateTime      @map("start_at")
  endAt               DateTime?     @map("end_at")
  actualStartAt       DateTime?     @map("actual_start_at")
  actualEndAt         DateTime?     @map("actual_end_at")
  googleEventId       String?       @unique @map("google_event_id")
  meetLink            String?       @map("meet_link")
  attendees           Json          @default("[]")    // [{email, responseStatus, organizer?, self?}]
  status              MeetingStatus @default(scheduled)
  scheduledByUserId   String        @map("scheduled_by_user_id")

  // Recording
  recordingDriveId    String?       @map("recording_drive_id")
  recordingUrl        String?       @map("recording_url")
  recordingMovedAt    DateTime?     @map("recording_moved_at")

  // Transcription
  transcriptionJobId  String?       @map("transcription_job_id")
  transcriptText      String?       @map("transcript_text")
  transcribedAt       DateTime?     @map("transcribed_at")
  nativeTranscriptUrl String?       @map("native_transcript_url")
  meetingSummary      String?       @map("meeting_summary")

  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")

  customer    Customer     @relation(fields: [customerId], references: [id])
  contact     Contact?     @relation(fields: [contactId], references: [id])
  meetingType MeetingType? @relation(fields: [meetingTypeId], references: [id])

  @@index([customerId])
  @@index([status])
  @@index([startAt])
  @@map("meetings")
}

// ─────────────────────────────────────────
// GOOGLE OAUTH
// ─────────────────────────────────────────

model GoogleToken {
  id           String   @id
  accessToken  String   @map("access_token")
  refreshToken String   @map("refresh_token")
  expiresAt    DateTime @map("expires_at")
  scope        String
  email        String
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("google_tokens")
}
