server {
    listen 80;
    server_name {{ app_domain }};

    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    location / {
        return 301 https://$server_name$request_uri;
    }
}

server {
    # `listen ... http2` e não a diretiva `http2 on;`: esta existe só a partir do
    # nginx 1.25.1 e o servidor roda 1.18.0 (Ubuntu 20.04), onde ela derruba o
    # `nginx -t` com "unknown directive". A forma antiga funciona nas duas.
    listen 443 ssl http2;
    server_name {{ app_domain }};

    ssl_certificate     /etc/letsencrypt/live/{{ app_domain }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ app_domain }}/privkey.pem;

    # Upload de criativo passa por server action com limite de 50 MB no Next.
    # Se o nginx cortar antes, o erro chega como 413 sem explicação na tela.
    client_max_body_size 50M;

    # ── ATENÇÃO À ORDEM ───────────────────────────────────────────────────────
    # /api NÃO pode ser roteado inteiro para o backend. O Next serve a própria
    # rota /api/events (o proxy de SSE do sino de notificações). Só o prefixo
    # /api/v1/ pertence ao NestJS; o resto de /api é do Next.

    # SSE do backend: sem desligar o buffering, o nginx segura os eventos e a
    # notificação em tempo real simplesmente não chega.
    location /api/v1/events {
        proxy_pass http://127.0.0.1:{{ backend_port }};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection '';
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 24h;
        chunked_transfer_encoding off;
    }

    # O Swagger não vive sob /api/v1: o main.ts registra SwaggerModule em
    # 'api/docs', fora do prefixo global. Sem esta location ele cai no Next e
    # vira 307 para /login — que foi o que aconteceu no primeiro deploy, com o
    # resumo do playbook anunciando uma URL que não abria.
    location /api/docs {
        proxy_pass http://127.0.0.1:{{ backend_port }};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /api/openapi {
        proxy_pass http://127.0.0.1:{{ backend_port }};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /api/v1/ {
        proxy_pass http://127.0.0.1:{{ backend_port }};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Upload de arquivo grande e sincronização com a Meta levam tempo.
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    # Proxy de SSE do próprio Next, que repassa o stream do backend.
    location /api/events {
        proxy_pass http://127.0.0.1:{{ frontend_port }};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection '';
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 24h;
        chunked_transfer_encoding off;
    }

    location / {
        proxy_pass http://127.0.0.1:{{ frontend_port }};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
    }
}
